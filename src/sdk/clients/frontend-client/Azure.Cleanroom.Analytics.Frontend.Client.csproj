<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>C# client SDK for the Azure Cleanroom Analytics Frontend API, generated from OpenAPI using AutoRest.</Description>
    <AssemblyTitle>Azure.Cleanroom.Analytics.Frontend.Client</AssemblyTitle>
    <PackageId>Azure.Cleanroom.Analytics.Frontend.Client</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Authors>Microsoft</Authors>
    <Company>Microsoft</Company>
    <PackageTags>Azure;Cleanroom;Analytics;Frontend;AutoRest;OpenAPI</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/azure-core/azure-cleanroom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/azure-core/azure-cleanroom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- All code in this project is auto-generated by AutoRest or shared source from the
         AutoRest C# code-gen package; do not enforce repo-wide style rules on it. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <NoWarn>$(NoWarn);CS1591;CS8632;SA0001;SA1600;SA1601;SA1602;SA1633</NoWarn>
    <!-- Do not auto-include arbitrary .cs in the repo; we explicitly include the generated tree. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The @autorest/csharp generator emits code that references shared types
         (e.g. Azure.Core.Pipeline.ClientDiagnostics) shipped as source via the
         Microsoft.Azure.AutoRest.CSharp package. -->
    <IncludeGeneratorSharedCode>true</IncludeGeneratorSharedCode>
    <RestoreAdditionalProjectSources>https://pkgs.dev.azure.com/azure-sdk/public/_packaging/azure-sdk-for-net/nuget/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.50.0" />
    <PackageReference Include="System.ClientModel" Version="1.10.0" />
    <PackageReference Include="Microsoft.Azure.AutoRest.CSharp" Version="3.0.0-beta.20251203.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- Strip the repo-wide StyleCop/Menees/threading analyzers added by Directory.Build.props. -->
  <ItemGroup>
    <PackageReference Remove="StyleCop.Analyzers" />
    <PackageReference Remove="Menees.Analyzers" />
    <PackageReference Remove="Microsoft.VisualStudio.Threading.Analyzers" />
    <AdditionalFiles Remove="@(AdditionalFiles)" />
  </ItemGroup>

  <!-- Only compile AutoRest output if it has been generated. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\generated')">
    <Compile Include="generated\**\*.cs" />
  </ItemGroup>

</Project>
